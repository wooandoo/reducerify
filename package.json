{
  "name": "reducerify",
  "version": "1.2.0",
  "description": "Type-safe reducers and tagged unions for TypeScript - simplify state management with automatic action creators and pattern matching",
  "author": "Frédéric Mascaro <frédéric.mascaro@gmail.com> (https://github.com/wooandoo)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wooandoo/reducerify.git"
  },
  "keywords": [
    "reducer",
    "typescript",
    "state-management",
    "functional",
    "immutable",
    "immer",
    "tagged-union",
    "discriminated-union",
    "pattern-matching",
    "zod",
    "type-safe",
    "sum-types"
  ],
  "bugs": {
    "url": "https://github.com/wooandoo/reducerify/issues"
  },
  "homepage": "https://github.com/wooandoo/reducerify#readme",
  "license": "MIT",
  "module": "dist/index.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reducer/immer": {
      "types": "./dist/reducer/immer.d.ts",
      "import": "./dist/reducer/immer.js"
    }
  },
  "scripts": {
    "test": "vitest",
    "clean": "rimraf dist",
    "build": "run-s clean build:compile build:xportify",
    "build:compile": "tsdown src/index.ts src/reducer/immer.ts",
    "build:xportify": "xportify --project . --dist ./dist --write",
    "lint": "biome check .",
    "ci": "pnpm build && pnpm lint && pnpm test",
    "prepare": "pnpm build",
    "examples": "run-s example:counter example:counter-with-immer example:todos example:authentication",
    "example:counter": "tsx examples/counter.ts",
    "example:counter-with-immer": "tsx examples/counter-with-immer.ts",
    "example:todos": "tsx examples/todos.ts",
    "example:authentication": "tsx examples/authentication.ts"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "tsdown": "^0.11.9",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "vitest": "^3.1.3",
    "xportify": "^1.0.7"
  },
  "peerDependencies": {
    "immer": "^10.1.1",
    "zod": "^4.1.12"
  },
  "peerDependenciesMeta": {
    "immer": {
      "optional": true
    }
  }
}